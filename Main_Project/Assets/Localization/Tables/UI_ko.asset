    m_Metadata:
      m_Items: []
  - m_Id: 7201290385298
    m_Localized: "\uBB34"
    m_Metadata:
      m_Items: []
  - m_Id: 9595419219841
    m_Localized: "\uC2A4\uD0AC \uC2AC\uB86F\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7676245330911
    m_Localized: "\uB2E4\uB978 \uC720\uB2DB\uC774 \uC0AC\uC6A9 \uC911\uC778 \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6880124753404
    m_Localized: "\uBCF4\uC720\uD558\uC9C0 \uC54A\uC740 \uD56D\uBAA9\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3081136264578
    m_Localized: "\uD2F0\uC5B4 3"
    m_Metadata:
      m_Items: []
  - m_Id: 9939486483501
    m_Localized: "\uD2F0\uC5B4 2"
    m_Metadata:
      m_Items: []
  - m_Id: 1008810955051
    m_Localized: "\uAD81\uADF9\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 3563166565345
    m_Localized: "\uCE58\uC720\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6430643576967
    m_Localized: "\uCE58\uC720\uAC00 \uD544\uC694\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8874059490520
    m_Localized: "\uACE8\uB4DC\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6184460874417
    m_Localized: "\uAC74\uAC15\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 7556103698696
    m_Localized: "\uBD80\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 2289293075356
    m_Localized: "\uCE58\uBA85\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 7546379343790
    m_Localized: "\uC774\uB984 : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1510407186979
    m_Localized: "\uD6A8\uACFC : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4550513930430
    m_Localized: "\uB808\uBCA8: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 5150930636389
    m_Localized: "\uB3C8: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9231578714737
    m_Localized: "{0}\uC2B9 {1}\uBB34 {2}\uD328"
    m_Metadata:
      m_Items: []
  - m_Id: 3793111384998
    m_Localized: "{0} \uAC00\uBB38\uC73C\uB85C \uC2DC\uC791\uD560\uAE4C\uC694?\n\uC2DC\uC791\uD558\uBA74
      \uAC00\uBB38\uC744 \uBC14\uAFC0 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8274088235687
    m_Localized: "\uC131\uACF5 \uD655\uB960 : {0}%\n\uC2E4\uD328(\uC720\uC9C0) \uD655\uB960
      : {1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 5486618319297
    m_Localized: "\uC7A5\uCC29\uB41C \uC544\uC774\uD15C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1717756194759
    m_Localized: "\uB9AC\uADF8 \uC815\uBCF4\uB97C \uBD88\uB7EC\uC624\uB294 \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 8684372269560
    m_Localized: "\uC6B0\uB9AC \uD300"
    m_Metadata:
      m_Items: []
  - m_Id: 8546687024332
    m_Localized: "\uB808\uBCA8\uC5C5 \uBE44\uC6A9 {0}\uACE8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1855990164109
    m_Localized: "{0}\uB97C \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2669651748540
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 3915245820485
    m_Localized: "\u201C\uD558\uB298\uACFC \uBC14\uB78C\uC744 \uC9C0\uBC30\uD558\uB294
      \uADC0\uC871 \uAC00\uBB38.\n\uBE60\uB974\uACE0 \uC6B0\uC544\uD55C \uC804\uC220\uC744
      \uC790\uB791\uD55C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 8097670945883
    m_Localized: "\uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 3147663190562
    m_Localized: "\u201C\uC232\uACFC \uC0DD\uBA85\uC758 \uC228\uACB0\uC744 \uC774\uC5B4\uBC1B\uC740
      \uAC00\uBB38.\n\uCE58\uC720\uC640 \uC7AC\uC0DD\uC758 \uD798\uC744 \uC9C0\uB154\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 7444225751061
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 2473946305703
    m_Localized: "\u201C\uC6A9\uC758 \uD53C\uAC00 \uD750\uB974\uB294 \uBD88\uAF43\uC758
      \uAC00\uBB38.\n\uAC15\uB825\uD55C \uACF5\uACA9\uACFC \uBD88\uAD74\uC758 \uAE30\uAC1C\uB85C
      \uC801\uC744 \uBD88\uD0DC\uC6B4\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 2719716998241
    m_Localized: "\uB8E8\uBA58"
    m_Metadata:
      m_Items: []
  - m_Id: 5409284014177
    m_Localized: "\u201C\uBE5B\uACFC \uCCA0\uC758 \uC9C8\uC11C\uB97C \uC218\uD638\uD558\uB294
      \uC131\uAE30\uC0AC \uAC00\uBB38.\n\uAD73\uAC74\uD55C \uBC29\uC5B4\uC640 \uC815\uC758\uC758
      \uD798\uC744 \uBBFF\uB294\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 5112203982308
    m_Localized: "\uB179\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 4033415795740
    m_Localized: "\u201C\uBC24\uACFC \uB2EC\uC758 \uC2E0\uBE44\uB97C \uB530\uB974\uB294
      \uADF8\uB9BC\uC790 \uAC00\uBB38.\n\uC740\uBC00\uD558\uACE0 \uCE58\uBA85\uC801\uC778
      \uC77C\uACA9\uC744 \uAC00\uD55C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 5038007080673
    m_Localized: "\uBAA8\uB974\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 1938549320094
    m_Localized: "\u201C\uC8FD\uC74C\uACFC \uC800\uC8FC\uC758 \uC0AC\uC81C\uB97C
      \uBAA8\uC2DC\uB294 \uAC00\uBB38.\n\uB9DD\uB839\uC758 \uD798\uC73C\uB85C \uC801\uC744
      \uC800\uC8FC\uD55C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 2112303006551
    m_Localized: "\uD3F4\uADF8\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 5044088708701
    m_Localized: "\u201C\uCC9C\uB465\uC758 \uC2E0\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC740
      \uC18D\uB3C4\uC758 \uAC00\uBB38.\n\uBC88\uAC1C\uCC98\uB7FC \uBE60\uB974\uACE0
      \uAC15\uB82C\uD55C \uACF5\uACA9\uC744 \uD3BC\uCE5C\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 7143287349910
    m_Localized: "\uB9C8\uB808"
    m_Metadata:
      m_Items: []
  - m_Id: 9327606126929
    m_Localized: "\u201C\uBC14\uB2E4\uC758 \uC2EC\uC5F0\uC744 \uD488\uC740 \uAC00\uBB38.\n\uD750\uB974\uB294
      \uBB3C\uCC98\uB7FC \uC720\uC5F0\uD558\uACE0 \uB0C9\uCCA0\uD558\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 9776041943449
    m_Localized: "\uD14C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2026216207008
    m_Localized: "\u201C\uB300\uC9C0\uC640 \uC0B0\uC758 \uC218\uD638\uC790 \uAC00\uBB38.\n\uAC15\uC778\uD55C
      \uBC29\uC5B4\uB825\uACFC \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uC758\uC9C0\uB97C
      \uAC00\uC9C4\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 1917726114099
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 9121744142524
    m_Localized: "\u201C\uBCC4\uACFC \uC6B4\uBA85\uC744 \uC77D\uB294 \uC608\uC5B8\uC790
      \uAC00\uBB38.\n\uC2E0\uBE44\uD55C \uD798\uC73C\uB85C \uC804\uC7A5\uC758 \uD750\uB984\uC744
      \uAFF0\uB6AB\uB294\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 4719073782864
    m_Localized: "\uAC8C\uC784 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 8744678320278
    m_Localized: "\uC7A5\uCC29\uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1182454420012
    m_Localized: "\uC7A5\uCC29\uBD88\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 1524159110787
    m_Localized: "\uAC80\uD22C\uC0AC \uC601\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 4417119104481
    m_Localized: "\uB77C\uC6B4\uB4DC \uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 7910581597746
    m_Localized: "\uC5D0\uD14C\uB9AC\uC6B0\uC2A4 \uC544\uC2A4\uD2B8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 5096671372289
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790
      \uC6B4\uBA85\uC758 \uC608\uC5B8\uC790. \uBCC4\uB4E4\uC758 \uC6C0\uC9C1\uC784\uC744
      \uD1B5\uD574 \uBBF8\uB798\uB97C \uC77D\uACE0, \uC6B4\uBA85\uC758 \uD750\uB984\uC744
      \uC870\uC885\uD558\uB294 \uAC15\uB825\uD55C \uD798\uC744 \uAC00\uC84C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2078809755764
    m_Localized: "\uC140\uB808\uB124 \uC544\uC2A4\uD2B8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2173690777788
    m_Localized: "\uB2EC\uC758 \uD798\uC744 \uB2E4\uB8E8\uB294 \uB9C8\uB140. \uADF8\uB140\uC758
      \uB9C8\uBC95\uC740 \uB2EC\uC758 \uC704\uC0C1\uC5D0 \uB530\uB77C \uBCC0\uD654\uD558\uBA70,
      \uC801\uC758 \uC815\uC2E0\uC744 \uD63C\uB780\uC5D0 \uBE60\uB728\uB9AC\uACE0
      \uD589\uB3D9\uC744 \uBC29\uD574\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5187293058353
    m_Localized: "\uCF54\uBA67 \uC544\uC2A4\uD2B8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 4098350090236
    m_Localized: "\uD61C\uC131\uCC98\uB7FC \uBE60\uB974\uACE0 \uAC15\uB825\uD55C
      \uACF5\uACA9\uC744 \uAC00\uD558\uB294 \uC804\uC0AC. \uADF8\uC758 \uAC80\uC740
      \uBCC4\uBE5B\uC744 \uB2F4\uACE0 \uC788\uC5B4, \uC801\uC5D0\uAC8C \uCE58\uBA85\uC801\uC778
      \uC77C\uACA9\uC744 \uAC00\uD560 \uB54C\uB9C8\uB2E4 \uBCC4\uBE5B\uC774 \uD3ED\uBC1C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1415957684961
    m_Localized: "\uC624\uB9AC\uC628 \uC544\uC2A4\uD2B8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 1029212047063
    m_Localized: "\uBCC4\uC790\uB9AC\uC758 \uD798\uC744 \uD65C\uC5D0 \uB2F4\uC544
      \uC0AC\uC6A9\uD558\uB294 \uAD81\uC218. \uC624\uB9AC\uC628\uC790\uB9AC\uC758
      \uD798\uC744 \uBE4C\uB824 \uC801\uC5D0\uAC8C \uCE58\uBA85\uC801\uC778 \uD654\uC0B4\uC744
      \uB0A0\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8733250306778
    m_Localized: "\uD0C0\uC774\uB77C \uC544\uC2A4\uD2B8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 3930993938188
    m_Localized: "\uC6B4\uBA85\uC758 \uC8FC\uC0AC\uC704\uB97C \uB358\uC838 \uC544\uAD70\uC5D0\uAC8C\uB294
      \uD589\uC6B4\uC744, \uC801\uC5D0\uAC8C\uB294 \uBD88\uC6B4\uC744 \uC120\uC0AC\uD558\uB294
      \uC608\uCE21 \uBD88\uAC00\uB2A5\uD55C \uC11C\uD3EC\uD130\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1227144294892
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8841150768514
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C
      \uCD08\uBCF4 \uAC80\uD22C\uC0AC. \uBCC4\uC758 \uD798\uC774 \uAE43\uB4E0 \uAC80\uC220\uC744
      \uC5F0\uB9C8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2011449125543
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 9324522416815
    m_Localized: "\uBCC4\uC758 \uBC29\uD328\uB97C \uB4E0 \uD6C8\uB828\uBCD1. \uC6B4\uBA85\uC758
      \uD750\uB984\uC744 \uB9C9\uC544\uB0B4\uB294 \uBC29\uC5B4\uB825\uC744 \uBC30\uC6B0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9242121145639
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 4249406508654
    m_Localized: "\uBCC4\uBE5B\uC758 \uADF8\uB9BC\uC790\uAC00 \uB418\uC5B4 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uC6B4\uBA85\uC744
      \uAC70\uC2A4\uB974\uB294 \uC18D\uB3C4\uB97C \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5787094085449
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 5359367101882
    m_Localized: "\uBCC4\uC790\uB9AC\uC758 \uD798\uC744 \uD65C\uC5D0 \uB2F4\uC544
      \uC2F8\uC6B0\uB294 \uCD08\uBCF4 \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C
      \uC801\uC744 \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3350978182002
    m_Localized: "\uC544\uC2A4\uD2B8\uB77C \uC2E0\uBCD1 \uC0AC\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 2718559177496
    m_Localized: "\uC2E0\uC131\uD55C \uBCC4\uBE5B\uC73C\uB85C \uC544\uAD70\uC744
      \uCE58\uC720\uD558\uB294 \uCD08\uBCF4 \uC0AC\uC81C. \uC6B4\uBA85\uC758 \uD750\uB984\uC744
      \uAE0D\uC815\uC801\uC73C\uB85C \uBC14\uAFB8\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1568246361678
    m_Localized: "\uC81C\uD53C\uB85C\uC2A4 \uCE74\uC774\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 7777599622557
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790
      \uD3ED\uD48D\uC758 \uC655. \uACE0\uACB0\uD558\uACE0 \uB0C9\uCCA0\uD55C \uB9AC\uB354\uC2ED\uC73C\uB85C
      \uBC14\uB78C\uCC98\uB7FC \uD300\uC744 \uC774\uB04C\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8268114464429
    m_Localized: "\uC2E4\uBC14 \uCE74\uC774\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 9196750137364
    m_Localized: "\uBC14\uB78C\uCC98\uB7FC \uC790\uC720\uB86D\uACE0 \uC608\uCE21
      \uBD88\uAC00\uB2A5\uD55C \uC6C0\uC9C1\uC784\uC73C\uB85C \uC801\uC744 \uAD50\uB780\uC2DC\uD0A4\uB294
      \uBB34\uD76C. \uC740\uBC00\uD558\uAC8C \uC801\uC758 \uAE09\uC18C\uB97C \uB178\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1196386609073
    m_Localized: "\uD14C\uC628 \uCE74\uC774\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 4626220384695
    m_Localized: "\uD558\uB298\uC758 \uAC00\uD638\uB97C \uBC1B\uC740 \uAD73\uAC74\uD55C
      \uBC29\uD328. \uC544\uAD70\uC744 \uBCF4\uD638\uD558\uBA70 \uC804\uC120\uC744
      \uC720\uC9C0\uD558\uB294 \uD5CC\uC2E0\uC801\uC778 \uC218\uD638\uC790\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3367822441087
    m_Localized: "\uC544\uC6B0\uB77C \uCE74\uC774\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 9333285260379
    m_Localized: "\uBC14\uB78C\uC758 \uAE30\uC6B4\uC744 \uB2F4\uC740 \uD654\uC0B4\uB85C
      \uC801\uC744 \uC800\uACA9\uD558\uB294 \uB0A0\uAC1C \uB2EC\uB9B0 \uAD81\uC218.
      \uC815\uAD50\uD558\uACE0 \uB0C9\uC815\uD55C \uD310\uB2E8\uB825\uC73C\uB85C
      \uC804\uD22C\uB97C \uC9C0\uC6D0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9956908853936
    m_Localized: "\uD15C\uD398\uC2A4\uD2B8 \uCE74\uC774\uB8E8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 7939989920534
    m_Localized: "\uAC00\uBB38\uC758 \uD798\uC744 \uAC00\uC7A5 \uC21C\uC218\uD558\uAC8C
      \uBB3C\uB824\uBC1B\uC740 \uD3ED\uD48D\uC758 \uB9C8\uB3C4\uC0AC. \uD1B5\uC81C\uD558\uAE30
      \uC5B4\uB824\uC6B4 \uACA9\uB82C\uD55C \uD3ED\uD48D\uC758 \uD798\uC744 \uB2E4\uB8F9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5306813627311
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 4279532680040
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C
      \uCD08\uBCF4 \uAC80\uD22C\uC0AC. \uBC14\uB78C\uC758 \uD798\uC744 \uAC80\uC5D0
      \uC2E4\uC5B4 \uC2F8\uC6B0\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8369728393963
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8425029957713
    m_Localized: "\uD558\uB298\uC758 \uAC00\uD638\uB97C \uBC1B\uC740 \uD6C8\uB828\uBCD1.
      \uAD73\uAC74\uD55C \uBC29\uD328\uB85C \uD300\uC744 \uC9C0\uD0A4\uB294 \uD6C8\uB828\uC744
      \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2980802141972
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1605330537671
    m_Localized: "\uBC14\uB78C\uCC98\uB7FC \uBE60\uB978 \uBAB8\uB180\uB9BC\uC744
      \uC790\uB791\uD558\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uC801\uC758 \uBE48\uD2C8\uC744
      \uB178\uB9AC\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1377662581259
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 4111704269358
    m_Localized: "\uBC14\uB78C\uC758 \uAE30\uC6B4\uC744 \uD65C\uC5D0 \uB2F4\uC544
      \uC2F8\uC6B0\uB294 \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744
      \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7555396529283
    m_Localized: "\uCE74\uC774\uB8E8\uC2A4 \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 3045806867223
    m_Localized: "\uD3ED\uD48D\uC758 \uD798\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uD1B5\uC81C\uD558\uAE30 \uC5B4\uB824\uC6B4 \uACA9\uB82C\uD55C
      \uB9C8\uBC95\uC744 \uBC30\uC6B0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2442574881629
    m_Localized: "\uD398\uB974\uC138\uD3EC\uB124 \uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 6179379013772
    m_Localized: "\uD50C\uB85C\uB77C \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790
      \uC232\uC758 \uC5EC\uC655. \uBAA8\uB4E0 \uC0DD\uBA85\uC758 \uD0C4\uC0DD\uACFC
      \uC18C\uBA78\uC744 \uAD00\uC7A5\uD558\uB294 \uC9C0\uD61C\uB85C\uC6B4 \uC0AC\uB0E5\uAFBC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3072709602660
    m_Localized: "\uD504\uB8E8\uB204\uC2A4 \uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 6685760878553
    m_Localized: "\uCC38\uB098\uBB34\uCC98\uB7FC \uAD73\uAC74\uD55C \uC2E0\uB150\uC744
      \uAC00\uC9C4 \uC232\uC758 \uC218\uD638\uC790. \uAC15\uB825\uD55C \uB369\uAD74\uB85C
      \uC801\uC744 \uC18D\uBC15\uD558\uACE0 \uC544\uAD70\uC744 \uBCF4\uD638\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9262798871245
    m_Localized: "\uB9CC\uB4DC\uB77C\uACE0\uB77C \uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 5286593980124
    m_Localized: "\uC544\uB984\uB2E4\uC6B4 \uC678\uBAA8 \uB4A4\uC5D0 \uCE58\uBA85\uC801\uC778
      \uB3C5\uC744 \uC228\uAE34 \uAC00\uC2DC\uAF43\uC758 \uB9C8\uB140. \uB3C5\uCD08\uC640
      \uB9F9\uB3C5\uC744 \uB2E4\uB8E8\uB294 \uC794\uD639\uD55C \uB9C8\uBC95\uC0AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6896184782186
    m_Localized: "\uC138\uBBF8\uC544 \uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 5343485757902
    m_Localized: "\uC232\uC758 \uC815\uB839\uB4E4\uACFC \uAD50\uAC10\uD558\uB294
      \uC21C\uC218\uD55C \uC601\uD63C\uC758 \uC815\uB839\uC0AC. \uBAA8\uB4E0 \uC0DD\uBA85\uC758
      \uC2DC\uC791\uC810\uC778 \uC528\uC557\uC758 \uD798\uC744 \uB2E4\uB8F9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2348211201775
    m_Localized: "\uBE44\uBC14 \uD50C\uB85C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 3495990950450
    m_Localized: "\uC232\uC758 \uD65C\uB825\uACFC \uC0DD\uBA85\uB825\uC744 \uAC80\uC5D0
      \uB2F4\uC544 \uC2F8\uC6B0\uB294 \uCF8C\uD65C\uD55C \uC804\uC0AC. \uADF8\uB140\uC758
      \uD65C\uB825\uC740 \uC544\uAD70\uC5D0\uAC8C \uD798\uC744, \uC801\uC5D0\uAC8C\uB294
      \uCE58\uBA85\uC801\uC778 \uC77C\uACA9\uC744 \uC120\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3794359681028
    m_Localized: "\uD50C\uB85C\uB77C \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1946523301240
    m_Localized: "\uD50C\uB85C\uB77C \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uC232\uC758 \uD65C\uB825\uC744 \uAC80\uC5D0 \uB2F4\uC544
      \uC2F8\uC6B0\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3559954484117
    m_Localized: "\uD50C\uB85C\uB77C \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8640385017418
    m_Localized: "\uB2E8\uB2E8\uD55C \uB098\uBB34 \uBC29\uD328\uB85C \uC544\uAD70\uC744
      \uBCF4\uD638\uD558\uB294 \uD6C8\uB828\uBCD1. \uC232\uC758 \uAD73\uAC74\uD568\uC744
      \uBC30\uC6B0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6363151481416
    m_Localized: "\uD50C\uB85C\uB77C \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 2887023062098
    m_Localized: "\uC232\uC758 \uADF8\uB9BC\uC790\uAC00 \uB418\uC5B4 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uD6C8\uB828\uBCD1. \uB3C5\uCD08\uB97C
      \uC0AC\uC6A9\uD558\uB294 \uBC95\uC744 \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4129177500879
    m_Localized: "\uD50C\uB85C\uB77C \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 9111773552662
    m_Localized: "\uC232\uC758 \uD65C\uB825\uC744 \uD65C\uC5D0 \uB2F4\uC544 \uC2F8\uC6B0\uB294
      \uCD08\uBCF4 \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744
      \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3690223928976
    m_Localized: "\uD50C\uB85C\uB77C \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1302446117809
    m_Localized: "\uC2DD\uBB3C \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uC232\uC758 \uD798\uC744 \uC774\uC6A9\uD574 \uC801\uC744
      \uACF5\uACA9\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7926383366443
    m_Localized: "\uCF00\uB77C\uC6B0\uB178\uC2A4 \uD3F4\uADF8\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 6719550833927
    m_Localized: "\uD3F4\uADF8\uB974 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790
      \uB1CC\uC804\uC758 \uC655. \uBC88\uAC1C\uCC98\uB7FC \uBE60\uB978 \uD310\uB2E8\uB825\uACFC
      \uC555\uB3C4\uC801\uC778 \uD798\uC73C\uB85C \uC804\uC7A5\uC744 \uC9C0\uBC30\uD558\uB294
      \uD638\uC804\uC801\uC778 \uB9AC\uB354\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1945405439455
    m_Localized: "\uC774\uB9AC\uC2A4 \uD3F4\uADF8\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 1586390333093
    m_Localized: "\uBC88\uAC1C\uC758 \uC2E0\uC744 \uBAA8\uC2DC\uB294 \uBB34\uB140\uC774\uC790
      \uAC00\uBB38\uC758 \uC815\uC2E0\uC801 \uC9C0\uC8FC. \uC9C8\uD48D \uAC19\uC740
      \uCDA4\uC73C\uB85C \uC544\uAD70\uC5D0\uAC8C \uC18D\uB3C4\uC640 \uBBFC\uCCA9\uC131\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2175201862246
    m_Localized: "\uD314\uB8E8\uC2A4 \uD3F4\uADF8\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 5514253492597
    m_Localized: "'\uD314\uB77C\uB4D0'\uCC98\uB7FC \uACAC\uACE0\uD55C \uBC88\uAC1C\uC758
      \uBC29\uD328. \uBC88\uAC1C \uC5D0\uB108\uC9C0\uB97C \uD761\uC218\uD558\uC5EC
      \uB354\uC6B1 \uB2E8\uB2E8\uD574\uC9C0\uBA70, \uBB35\uBB35\uD788 \uC544\uAD70\uC744
      \uBCF4\uD638\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7644756744825
    m_Localized: "\uBCFC\uD22C\uC2A4 \uD3F4\uADF8\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 4547901096880
    m_Localized: "\uBCC0\uD654\uC640 \uD68C\uC804\uC744 \uB73B\uD558\uB294 \uC774\uB984\uCC98\uB7FC,
      \uBC88\uAC1C\uCC98\uB7FC \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294 \uC554\uC0B4\uC790.
      \uBC88\uAC1C \uC5D0\uB108\uC9C0\uB97C \uB2F4\uC740 \uD45C\uCC3D\uC73C\uB85C
      \uC801\uC744 \uACF5\uB7B5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1661954435741
    m_Localized: "\uC544\uB974\uB374\uC2A4 \uD3F4\uADF8\uB974"
    m_Metadata:
      m_Items: []
  - m_Id: 4463770991480
    m_Localized: "'\uB9F9\uB82C\uD55C'\uC774\uB77C\uB294 \uC774\uB984\uCC98\uB7FC,
      \uAC00\uBB38 \uB0B4\uC5D0\uC11C \uAC00\uC7A5 \uAC15\uB825\uD558\uACE0 \uD30C\uAD34\uC801\uC778
      \uBC88\uAC1C \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uB9C8\uBC95\uC0AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3154116753956
    m_Localized: "\uD3F4\uADF8\uB974 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6215191410751
    m_Localized: "\uD3F4\uADF8\uB974 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uBC88\uAC1C\uCC98\uB7FC \uBE60\uB978 \uAC80\uC220\uC744
      \uC5F0\uB9C8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1941158680320
    m_Localized: "\uD3F4\uADF8\uB974 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 3981660663383
    m_Localized: "\uBC88\uAC1C\uC758 \uAC11\uC637\uC744 \uB2E4\uB8E8\uB294 \uD6C8\uB828\uBCD1.
      \uAD73\uAC74\uD55C \uBC29\uD328\uB85C \uD300\uC744 \uC9C0\uD0A4\uB294 \uD6C8\uB828\uC744
      \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1167849175512
    m_Localized: "\uD3F4\uADF8\uB974 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 5391736795934
    m_Localized: "\uC804\uAD11\uC11D\uD654\uCC98\uB7FC \uBE60\uB978 \uBAB8\uB180\uB9BC\uC744
      \uC790\uB791\uD558\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uC801\uC758 \uBE48\uD2C8\uC744
      \uB178\uB9AC\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9288178434725
    m_Localized: "\uD3F4\uADF8\uB974 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 1160223092929
    m_Localized: "\uCC9C\uB465\uC758 \uD654\uC0B4\uC744 \uC3D8\uB294 \uCD08\uBCF4
      \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744 \uC81C\uC555\uD558\uB294
      \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8267349141298
    m_Localized: "\uD3F4\uADF8\uB974 \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 3729616549103
    m_Localized: "\uB1CC\uC6B4 \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uAC15\uB825\uD55C \uBC88\uAC1C\uB85C \uC801\uC744 \uC81C\uC555\uD558\uB294
      \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2147871111383
    m_Localized: "\uC544\uD03C\uB77C \uC774\uADF8\uB2C8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 9584982914528
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790
      \uBD88\uC758 \uAD70\uC8FC. \uC6A9\uC758 \uD53C\uB97C \uC774\uC5B4\uBC1B\uC544
      \uC804\uC7A5\uC744 \uBD88\uAF43\uC73C\uB85C \uC9C0\uBC30\uD558\uC9C0\uB9CC,
      \uC790\uC2E0\uC758 \uD798\uACFC \uCC45\uC784\uAC10 \uC0AC\uC774\uC5D0\uC11C
      \uACE0\uB1CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4428283881229
    m_Localized: "\uBCA0\uC2A4\uD398\uB974 \uC774\uADF8\uB2C8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 9283164249143
    m_Localized: "\uC544\uD03C\uB77C\uC758 \uC870\uCE74\uC774\uC790 \uAC00\uC7A5
      \uC720\uB825\uD55C \uD6C4\uACC4\uC790. \uB0C9\uC815\uD558\uACE0 \uCE58\uBC00\uD55C
      \uC131\uACA9\uC73C\uB85C \uC6A9\uC758 \uD798\uC740 \uD1B5\uC81C\uBCF4\uB2E4
      \uD574\uBC29\uB418\uC5B4\uC57C \uD55C\uB2E4\uACE0 \uBBFF\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2174131815921
    m_Localized: "\uB4DC\uB77C\uCF54 \uC774\uADF8\uB2C8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 5602351996170
    m_Localized: "\uC544\uD03C\uB77C\uC758 \uB3D9\uC0DD\uC774\uC790 \uAC00\uBB38\uC758
      \uAE30\uB465. \uC6A9\uC758 \uBE44\uB298\uCC98\uB7FC \uB2E8\uB2E8\uD55C \uBC29\uC5B4\uB825\uC744
      \uAC00\uC84C\uC73C\uBA70, \uBB35\uBB35\uD788 \uAC00\uBB38\uACFC \uC218\uC7A5\uC744
      \uC9C0\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6172654445576
    m_Localized: "\uD53C\uB77C \uC774\uADF8\uB2C8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 2629448147913
    m_Localized: "\uC6A9\uC758 \uD53C\uAC00 \uB9C8\uBC95 \uC7AC\uB2A5\uC73C\uB85C
      \uBC1C\uD604\uB41C \uC7A0\uC7AC\uC801 \uD6C4\uACC4\uC790 \uD6C4\uBCF4. \uBD84\uB178\uAC00
      \uB9C8\uBC95\uC758 \uD798\uC744 \uC99D\uD3ED\uC2DC\uD0A4\uB294 \uB2E4\uD608\uC9C8\uC801\uC778
      \uB9C8\uBC95\uC0AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6634427161945
    m_Localized: "\uC774\uADF8\uB098\uD2F0\uC6B0\uC2A4 \uC774\uADF8\uB2C8\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 8807299878589
    m_Localized: "\uBD88\uAF43\uC758 \uD65C\uB825\uC744 \uC5F0\uAD6C\uD558\uB294
      \uAC00\uBB38\uC758 \uC804\uB839. \uBCA0\uC2A4\uD398\uB974\uC640 \uD53C\uB77C\uC758
      \uACBD\uC7C1\uC744 \uC911\uC7AC\uD558\uBA70 \uAC00\uBB38\uC758 \uADE0\uD615\uC744
      \uC7A1\uB294 \uC5ED\uD560\uC744 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3838231780250
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 4251198324773
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C
      \uCD08\uBCF4 \uAC80\uD22C\uC0AC. \uBD88\uAF43\uC744 \uAC80\uC5D0 \uC2E4\uC5B4
      \uC2F8\uC6B0\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5172257073755
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 3241116656734
    m_Localized: "\uBD88\uC758 \uAC00\uD638\uB97C \uBC1B\uC740 \uD6C8\uB828\uBCD1.
      \uC6A9\uC758 \uBE44\uB298\uCC98\uB7FC \uB2E8\uB2E8\uD55C \uBC29\uD328\uB97C
      \uB2E4\uB8E8\uB294 \uBC95\uC744 \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2476817370239
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 7124182754178
    m_Localized: "\uC6A9\uC758 \uD53C\uAC00 \uAC00\uC838\uC624\uB294 \uBD84\uB178\uB97C
      \uB2E4\uB8E8\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uBE60\uB978 \uC18D\uB3C4\uB85C
      \uC801\uC758 \uBE48\uD2C8\uC744 \uB178\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2711613278521
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 5180411476139
    m_Localized: "\uBD88\uAF43\uC758 \uD798\uC744 \uD654\uC0B4\uC5D0 \uB2F4\uC544
      \uC2F8\uC6B0\uB294 \uCD08\uBCF4 \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C
      \uC801\uC744 \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4258490488708
    m_Localized: "\uC774\uADF8\uB2C8\uC2A4 \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 4163161399344
    m_Localized: "\uBD88\uAF43 \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uAC15\uB825\uD55C \uD654\uC5FC\uC73C\uB85C \uC801\uC744
      \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3432261860449
    m_Localized: "\uCE74\uC2A4\uD2F0\uC5D4 \uB8E8\uBA58"
    m_Metadata:
      m_Items: []
  - m_Id: 6507664787111
    m_Localized: "\uB8E8\uBA58 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790 \uBE5B\uC758
      \uC131\uAE30\uC0AC\uB2E8\uC7A5. \uC808\uB300\uC801\uC778 \uC815\uC758\uB97C
      \uCD94\uAD6C\uD558\uBA70, \uBE5B\uC758 \uBC29\uD328\uB85C \uC544\uAD70\uC744
      \uBCF4\uD638\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782459058675
    m_Localized: "\uC544\uB974\uD0A4\uC2A4 \uB8E8\uBA58"
    m_Metadata:
      m_Items: []
  - m_Id: 8108881944716
    m_Localized: "\uC804\uC124\uC801\uC778 \uB300\uC7A5\uC7A5\uC774. \uC790\uC2E0\uC774
      \uB9CC\uB4E0 \uCCA0\uC758 \uBC29\uD328\uC640 \uAC11\uC637\uC73C\uB85C \uC544\uAD70\uC744
      \uBCF4\uD638\uD558\uBA70, \uCE74\uC2A4\uD2F0\uC5D4\uC758 \uAD73\uAC74\uD55C
      \uC870\uC5B8\uC790\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2631637613013
    m_Localized: "\uC138\uB77C\uD53C\uB098 \uB8E8\uBA58"
    m_Metadata:
      m_Items: []
  - m_Id: 7695211516968
    m_Localized: "\uAC00\uBB38\uC758 \uCE58\uC720\uB97C \uB2F4\uB2F9\uD558\uB294
      \uC2E0\uC131\uD55C \uC0AC\uC81C. \uBE5B\uC758 \uD798\uC73C\uB85C \uC544\uAD70\uC744
      \uCE58\uC720\uD558\uACE0 \uC5B4\uB460\uC758 \uC800\uC8FC\uB97C \uC815\uD654\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7703573702170
    m_Localized: "\uD398\uB9AC\uC628 \uB8E8\uBA58"
    m_Metadata:
      m_Items: []
  - m_Id: 2441332353096
    m_Localized: "\uBE5B\uC758 \uB9C8\uBC95\uC774 \uAE43\uB4E0 \uCC3D\uC744 \uC0AC\uC6A9\uD558\uB294
      \uCC3D\uAE30\uC0AC. \uAC00\uBB38\uC758 \uBA85\uC608\uB97C \uC704\uD574 \uC804\uC7A5\uC5D0\uC11C
      \uB204\uAD6C\uBCF4\uB2E4 \uC55E\uC7A5\uC11C\uC11C \uC2F8\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8720984176933
    m_Localized: "\uD06C\uB9AC\uC2A4\uD0C8 \uB8E8\uBA58"
    m_Metadata:
      m_Items: []
  - m_Id: 9112820017768
    m_Localized: "\uC2E0\uBE44\uD55C \uAE08\uC18D \uD050\uBE0C\uB97C \uB2E4\uB8E8\uB294
      \uB9C8\uBC95 \uBC29\uC5B4 \uC804\uBB38\uAC00. \uCE68\uCC29\uD55C \uC131\uACA9\uC73C\uB85C
      \uC801\uC758 \uB9C8\uBC95 \uACF5\uACA9\uC744 \uBB34\uB825\uD654\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2930433069540
    m_Localized: "\uB8E8\uBA58 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8066258302229
    m_Localized: "\uB8E8\uBA58 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uBE5B\uC758 \uAC80\uC220\uC744 \uC5F0\uB9C8\uD558\uBA70
      \uC815\uC758\uB97C \uC704\uD574 \uC2F8\uC6B0\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4700450217317
    m_Localized: "\uB8E8\uBA58 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 2976978637263
    m_Localized: "\uCCA0\uC758 \uBC29\uD328\uB97C \uB4E0 \uD6C8\uB828\uBCD1. \uAD73\uAC74\uD55C
      \uBC29\uC5B4\uB825\uC73C\uB85C \uC544\uAD70\uC744 \uBCF4\uD638\uD558\uB294
      \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5716773967014
    m_Localized: "\uB8E8\uBA58 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 8862447183520
    m_Localized: "\uBE5B\uC744 \uC774\uC6A9\uD574 \uADF8\uB9BC\uC790\uB97C \uB9CC\uB4DC\uB294
      \uCD08\uBCF4 \uC554\uC0B4\uC790. \uBE5B\uACFC \uC5B4\uB460\uC758 \uC774\uC911\uC131\uC744
      \uBC30\uC6B0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2463458054443
    m_Localized: "\uB8E8\uBA58 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8160551497982
    m_Localized: "\uBE5B\uC758 \uD654\uC0B4\uC744 \uC3D8\uB294 \uCD08\uBCF4 \uCC99\uD6C4\uBCD1.
      \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744 \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744
      \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7806128831499
    m_Localized: "\uB8E8\uBA58 \uC2E0\uBCD1 \uC0AC\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 4382794359615
    m_Localized: "\uC2E0\uC131\uD55C \uBE5B\uC73C\uB85C \uC544\uAD70\uC744 \uCE58\uC720\uD558\uB294
      \uCD08\uBCF4 \uC0AC\uC81C. \uBE5B\uC758 \uD798\uC73C\uB85C \uC0C1\uCC98\uB97C
      \uD68C\uBCF5\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9310256951337
    m_Localized: "\uC544\uD2C0\uB77C\uC2A4 \uB9C8\uB808"
    m_Metadata:
      m_Items: []
  - m_Id: 5280153130052
    m_Localized: "\uB9C8\uB808 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790 \uD574\uC2E0\uC758
      \uAD70\uC8FC. \uAC70\uB300\uD55C \uBC14\uB2E4\uC758 \uD798\uC744 \uB2E4\uC2A4\uB9AC\uBA70,
      \uAE4A\uC740 \uC2EC\uD574\uCC98\uB7FC \uAC10\uC815\uC744 \uB4DC\uB7EC\uB0B4\uC9C0
      \uC54A\uB294 \uB0C9\uC815\uD55C \uB9AC\uB354\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2266895764927
    m_Localized: "\uC5D0\uC774\uB974 \uB9C8\uB808"
    m_Metadata:
      m_Items: []
  - m_Id: 1729444456230
    m_Localized: "\uBC14\uB2E4\uC758 \uC2EC\uC5F0\uC5D0 \uC228\uACA8\uC9C4 \uC5B4\uB460\uC758
      \uD798\uC744 \uB2E4\uB8E8\uB294 \uB9C8\uB140. \uB3C5\uACFC \uC800\uC8FC\uB97C
      \uD1B5\uD574 \uC801\uC744 \uBB34\uB825\uD654\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4280058987889
    m_Localized: "\uC138\uB80C \uB9C8\uB808"
    m_Metadata:
      m_Items: []
  - m_Id: 9714905162467
    m_Localized: "\uBB3C\uACB0\uCC98\uB7FC \uBD80\uB4DC\uB7FD\uC9C0\uB9CC \uBC14\uC704\uCC98\uB7FC
      \uAD73\uAC74\uD55C \uBC29\uC5B4\uB825\uC744 \uAC00\uC9C4 \uC804\uC0AC. \uBB3C\uB85C
      \uB9CC\uB4E4\uC5B4\uC9C4 \uBC29\uD328\uB85C \uC544\uAD70\uC744 \uBCF4\uD638\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1283640425550
    m_Localized: "\uB124\uB808\uC774\uB4DC \uB9C8\uB808"
    m_Metadata:
      m_Items: []
  - m_Id: 3438261224752
    m_Localized: "\uD574\uB958\uCC98\uB7FC \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294
      \uC554\uC0B4\uC790. \uBB3C\uC758 \uD750\uB984\uC744 \uC77D\uC5B4 \uC801\uC758
      \uC6C0\uC9C1\uC784\uC744 \uC608\uCE21\uD558\uACE0, \uB0A0\uCE74\uB85C\uC6B4
      \uC30D\uAC80\uC73C\uB85C \uC801\uC758 \uAE09\uC18C\uB97C \uCC0C\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9808411672876
    m_Localized: "\uC544\uD154 \uB9C8\uB808"
    m_Metadata:
      m_Items: []
  - m_Id: 9347771227756
    m_Localized: "\uC870\uC218\uC758 \uD750\uB984\uC744 \uD1B5\uD574 \uBBF8\uB798\uB97C
      \uC608\uC5B8\uD558\uB294 \uC608\uC5B8\uC790. \uADF8\uB140\uC758 \uC608\uC5B8\uC740
      \uC544\uAD70\uC5D0\uAC8C \uC2B9\uB9AC\uC758 \uAE30\uD68C\uB97C, \uB178\uB798\uB294
      \uCE58\uC720\uC758 \uD798\uC744 \uC120\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8783523210064
    m_Localized: "\uB9C8\uB808 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 4077405574250
    m_Localized: "\uB9C8\uB808 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uD30C\uB3C4\uCC98\uB7FC \uC720\uC5F0\uD558\uACE0 \uAC15\uB825\uD55C
      \uAC80\uC220\uC744 \uC5F0\uB9C8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7489452493237
    m_Localized: "\uB9C8\uB808 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 9285662009769
    m_Localized: "\uBC14\uB2E4\uC758 \uBC29\uD328\uB97C \uB4E0 \uD6C8\uB828\uBCD1.
      \uC5BC\uC74C\uCC98\uB7FC \uAD73\uAC74\uD55C \uBC29\uC5B4\uB825\uC744 \uBC30\uC6B0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6094701277599
    m_Localized: "\uB9C8\uB808 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 3673297466425
    m_Localized: "\uBC14\uB2E4\uC758 \uADF8\uB9BC\uC790\uAC00 \uB418\uC5B4 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uBB3C\uC758
      \uD750\uB984\uCC98\uB7FC \uC720\uC5F0\uD558\uAC8C \uC6C0\uC9C1\uC774\uB294
      \uBC95\uC744 \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1637972374937
    m_Localized: "\uB9C8\uB808 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 6217290160874
    m_Localized: "\uC5BC\uC74C \uD654\uC0B4\uC744 \uC3D8\uB294 \uCD08\uBCF4 \uCC99\uD6C4\uBCD1.
      \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744 \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744
      \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8820034630453
    m_Localized: "\uB9C8\uB808 \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6552176799614
    m_Localized: "\uBB3C\uC758 \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uAC15\uB825\uD55C \uBB3C\uC904\uAE30\uB85C \uC801\uC744
      \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8934424977176
    m_Localized: "\uBAA8\uB974\uD398\uC6B0\uC2A4 \uBAA8\uB974\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 9126132177118
    m_Localized: "\uBAA8\uB974\uC2A4 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790
      \uC8FD\uC74C\uC758 \uC0AC\uC81C\uC7A5. \uD574\uACE8 \uB9C8\uC2A4\uD06C\uB97C
      \uC4F0\uACE0 \uC0DD\uACFC \uC0AC\uC758 \uACBD\uACC4\uB97C \uD5C8\uBB34\uB294
      \uAC15\uB825\uD55C \uB9C8\uBC95\uC0AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1404448406395
    m_Localized: "\uB9AC\uC138 \uBAA8\uB974\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 8425406312668
    m_Localized: "\uC800\uC8FC \uC778\uD615\uC744 \uB9CC\uB4E4\uC5B4 \uC801\uC758
      \uB2A5\uB825\uC744 \uC57D\uD654\uC2DC\uD0A4\uACE0 \uC870\uC885\uD558\uB294
      \uC778\uD615\uC220\uC0AC. \uC21C\uC9C4\uD55C \uC678\uBAA8\uC640 \uB2EC\uB9AC
      \uCE58\uBA85\uC801\uC778 \uC800\uC8FC\uB97C \uB2E4\uB8F9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8905241515728
    m_Localized: "\uC138\uB098 \uBAA8\uB974\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 5421171578767
    m_Localized: "\uC8FD\uC740 \uC790\uC758 \uBF08\uB85C \uAC11\uC637\uC744 \uB9CC\uB4E4\uC5B4
      \uC785\uC740 \uC5EC\uC790 \uAE30\uC0AC. \uACFC\uAC70\uC758 \uC0C1\uC2E4\uC744
      \uADF9\uBCF5\uD558\uACE0 \uC8FD\uC74C\uC744 \uB450\uB824\uC6CC\uD558\uC9C0
      \uC54A\uB294 \uAD73\uAC74\uD55C \uBC29\uC5B4 \uC804\uC0AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2535593564491
    m_Localized: "\uC2A4\uD399\uD2B8\uB77C \uBAA8\uB974\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 3186634837593
    m_Localized: "\uB9DD\uC790\uC758 \uC601\uD63C\uC774 \uAE43\uB4E0 \uD654\uC0B4\uC744
      \uC0AC\uC6A9\uD558\uB294 \uAD81\uC218. \uADF8\uB140\uC758 \uD654\uC0B4\uC740
      \uC801\uC758 \uC0DD\uBA85\uB825\uC744 \uAC09\uC544\uBA39\uB294 \uCE58\uBA85\uC801\uC778
      \uC800\uC8FC\uB97C \uB2F4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4518092446779
    m_Localized: "\uBE14\uB7EC\uB4DC \uBAA8\uB974\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 1345413806296
    m_Localized: "\uC790\uC2E0\uC758 \uD53C\uC5D0 \uB2F4\uAE34 \uC8FD\uC74C\uC758
      \uD798\uC744 \uC774\uC6A9\uD574 \uC2F8\uC6B0\uB294 \uAC15\uB825\uD55C \uC804\uC0AC.
      \uD53C\uB97C \uBC14\uCCD0 \uC544\uAD70\uC744 \uAC15\uD654\uD558\uACE0 \uC801\uC744
      \uBB34\uCC0C\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2852881038837
    m_Localized: "\uBAA8\uB974\uC2A4 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8077650520232
    m_Localized: "\uBAA8\uB974\uC2A4 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uC8FD\uC74C\uC758 \uD798\uC774 \uAE43\uB4E0 \uAC80\uC220\uC744
      \uC5F0\uB9C8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2077262780068
    m_Localized: "\uBAA8\uB974\uC2A4 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8293576752004
    m_Localized: "\uBF08\uB85C \uB9CC\uB4E0 \uBC29\uD328\uB97C \uB2E4\uB8E8\uB294
      \uD6C8\uB828\uBCD1. \uC8FD\uC74C\uC758 \uD798\uC744 \uBC29\uD328\uC5D0 \uB2F4\uB294
      \uBC95\uC744 \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9449560969275
    m_Localized: "\uBAA8\uB974\uC2A4 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 8381590650835
    m_Localized: "\uC8FD\uC74C\uC758 \uADF8\uB9BC\uC790\uAC00 \uB418\uC5B4 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uB3C5\uC744
      \uC0AC\uC6A9\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7482421790848
    m_Localized: "\uBAA8\uB974\uC2A4 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 4693882901270
    m_Localized: "\uB9DD\uC790\uC758 \uC601\uD63C\uC744 \uD654\uC0B4\uC5D0 \uB2F4\uC544
      \uC2F8\uC6B0\uB294 \uCD08\uBCF4 \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C
      \uC801\uC744 \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3212545949322
    m_Localized: "\uBAA8\uB974\uC2A4 \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 3792394008657
    m_Localized: "\uC800\uC8FC \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uC8FD\uC740 \uC790\uC758 \uD798\uC744 \uC774\uC6A9\uD574
      \uC801\uC744 \uC81C\uC555\uD558\uB824 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4498825396371
    m_Localized: "\uB8E8\uD53C\uB098 \uB179\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 1307079291580
    m_Localized: "\uB179\uC2A4 \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790 \uBC24\uC758
      \uAD70\uC8FC. \uB0AE\uC5D0\uB294 \uADC0\uC871, \uBC24\uC5D0\uB294 \uC554\uC0B4\uC790\uB85C
      \uBCC0\uBAA8\uD558\uBA70, \uAC00\uBB38\uC758 \uC774\uC775\uC744 \uC704\uD574
      \uD589\uB3D9\uD558\uB294 \uB0C9\uCCA0\uD55C \uC804\uB7B5\uAC00\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9483058538006
    m_Localized: "\uC2E4\uBC84\uB9B0 \uB179\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 5490579795904
    m_Localized: "\uB2EC\uBE5B\uC758 \uD798\uC744 \uB9C8\uBC95\uC73C\uB85C \uAD6C\uD604\uD558\uB294
      \uAC00\uBB38\uC758 \uB9C8\uBC95\uC0AC. \uC801\uC758 \uC815\uC2E0\uC744 \uD63C\uB780\uC5D0
      \uBE60\uB728\uB9AC\uACE0 \uD798\uC744 \uC57D\uD654\uC2DC\uD0A4\uB294 \uB370
      \uD2B9\uD654\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4388834160321
    m_Localized: "\uC138\uB974\uD39C\uC2A4 \uB179\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 6681706765410
    m_Localized: "\uB3C5\uC0AC\uC758 \uCE7C\uB0A0\uCC98\uB7FC \uCE58\uBA85\uC801\uC778
      \uACF5\uACA9\uC744 \uB0A0\uB9AC\uB294 \uC554\uC0B4\uC790. \uB9F9\uB3C5\uC744
      \uB2E4\uB8E8\uB294 \uB370 \uD2B9\uD654\uB418\uC5B4 \uC788\uC73C\uBA70, \uB8E8\uD53C\uB098\uC5D0\uAC8C
      \uC808\uB300\uC801\uC73C\uB85C \uCDA9\uC131\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9898100059627
    m_Localized: "\uD398\uC77C \uB179\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 3630755089023
    m_Localized: "\uC5B4\uB460\uACFC \uADF8\uB9BC\uC790\uC758 \uD798\uC73C\uB85C
      \uBC29\uD328\uB97C \uB9CC\uB4DC\uB294 \uC804\uC0AC. \uACFC\uBB35\uD558\uACE0
      \uBB35\uC9C1\uD55C \uC131\uACA9\uC73C\uB85C, \uD300\uC758 \uB4E0\uB4E0\uD55C
      \uBC29\uC5B4\uC120\uC744 \uAD6C\uCD95\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4835780396265
    m_Localized: "\uC5D0\uCF54 \uB179\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 7494634380845
    m_Localized: "\uBCC4\uACFC \uC6B4\uBA85\uC744 \uC77D\uB294 \uC608\uC5B8\uC790.
      \uC608\uC9C0 \uB2A5\uB825\uC744 \uD1B5\uD574 \uC544\uAD70\uC5D0\uAC8C \uC2B9\uB9AC\uC758
      \uAE30\uD68C\uB97C \uC81C\uACF5\uD558\uB294 \uC2E0\uBE44\uB85C\uC6B4 \uC11C\uD3EC\uD130\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3654564785964
    m_Localized: "\uB179\uC2A4 \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6049881862669
    m_Localized: "\uB179\uC2A4 \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uC5B4\uB460 \uC18D\uC5D0\uC11C \uC2F8\uC6B0\uB294 \uAC80\uC220\uC744
      \uC5F0\uB9C8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8559442072447
    m_Localized: "\uB179\uC2A4 \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 5745975571334
    m_Localized: "\uADF8\uB9BC\uC790 \uBC29\uD328\uB97C \uB2E4\uB8E8\uB294 \uD6C8\uB828\uBCD1.
      \uC5B4\uB460\uC758 \uD798\uC744 \uBC29\uD328\uC5D0 \uB2F4\uB294 \uBC95\uC744
      \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8824727278608
    m_Localized: "\uB179\uC2A4 \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 6485792370772
    m_Localized: "\uBC24\uC758 \uADF8\uB9BC\uC790\uAC00 \uB418\uC5B4 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uC740\uBC00\uD55C
      \uC6C0\uC9C1\uC784\uC744 \uBC30\uC6C1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1472679217121
    m_Localized: "\uB179\uC2A4 \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8434049848360
    m_Localized: "\uB2EC\uBE5B\uC758 \uD654\uC0B4\uC744 \uC3D8\uB294 \uCD08\uBCF4
      \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C \uC801\uC744 \uC81C\uC555\uD558\uB294
      \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1488827811968
    m_Localized: "\uB179\uC2A4 \uC2E0\uBCD1 \uC8FC\uC220\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 8475504816409
    m_Localized: "\uC5B4\uB460 \uB9C8\uBC95\uC744 \uB2E4\uB8E8\uB294 \uCD08\uBCF4
      \uC8FC\uC220\uC0AC. \uAC15\uB825\uD55C \uB9C8\uBC95\uC73C\uB85C \uC801\uC744
      \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6636879286520
    m_Localized: "\uB9C8\uADF8\uB204\uC2A4 \uD14C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 9215438641899
    m_Localized: "\uD14C\uB77C \uAC00\uBB38\uC758 \uC218\uC7A5\uC774\uC790 \uB300\uC9C0\uC758
      \uAD70\uC8FC. \uC0B0\uCC98\uB7FC \uAC70\uB300\uD55C \uCCB4\uAD6C\uC640 \uAD73\uAC74\uD55C
      \uBC29\uC5B4\uB825\uC744 \uAC00\uC84C\uC73C\uBA70, \uB300\uC9C0\uC758 \uBAA9\uC18C\uB9AC\uC5D0
      \uADC0 \uAE30\uC6B8\uC774\uB294 \uC9C0\uD61C\uB85C\uC6B4 \uB9AC\uB354\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6534902259010
    m_Localized: "\uB85D\uC2A4 \uD14C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2106110797929
    m_Localized: "\uB300\uC9C0\uC758 \uADFC\uC6D0\uC778 \uBC14\uC704\uC758 \uD798\uC744
      \uB2E4\uB8E8\uB294 \uC804\uC0AC. \uADF8\uC758 \uBAB8\uC740 \uBC14\uC704\uCC98\uB7FC
      \uB2E8\uB2E8\uD558\uBA70, \uB9DD\uCE58\uB97C \uD718\uB450\uB97C \uB54C\uB9C8\uB2E4
      \uC9C0\uCD95\uC744 \uC6B8\uB9AC\uB294 \uD798\uC744 \uBC1C\uD718\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8098548915857
    m_Localized: "\uC2E4\uBC14\uB098 \uD14C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2924284574072
    m_Localized: "\uB300\uC9C0\uC758 \uC0DD\uBA85\uB825\uC744 \uB2E4\uB8E8\uB294
      \uCE58\uC720\uC0AC\uC774\uC790 \uC0AC\uC81C. \uADF8\uB140\uB294 \uAD73\uAC74\uD55C
      \uBC14\uC704\uC758 \uD798\uC744 \uB2E4\uB8E8\uB294 \uB2E4\uB978 \uAC00\uC871\uB4E4\uACFC
      \uB2EC\uB9AC, \uC232\uACFC \uC0DD\uBA85, \uD48D\uC694\uC758 \uD798\uC744 \uC911\uC694\uD558\uAC8C
      \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2014152980494
    m_Localized: "\uD398\uB860 \uD14C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 5774961093539
    m_Localized: "\uC232\uC758 \uD3EC\uC2DD\uC790\uCC98\uB7FC \uBE60\uB974\uACE0
      \uC815\uAD50\uD55C \uAC80\uC220\uC744 \uC0AC\uC6A9\uD558\uB294 \uC804\uC0AC.
      \uADF8\uC758 \uAC80\uC740 \uACE0\uB300 \uB098\uBB34\uC758 \uBFCC\uB9AC\uB85C
      \uB9CC\uB4E4\uC5B4\uC84C\uC73C\uBA70, \uC232\uC758 \uB9F9\uB82C\uD55C \uC0DD\uBA85\uB825\uC774
      \uAE43\uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7784795474099
    m_Localized: "\uB8E8\uD478\uC2A4 \uD14C\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 5010800849180
    m_Localized: "'\uB291\uB300'\uCC98\uB7FC \uC0B0\uC744 \uB204\uBE44\uB294 \uB0A0\uB835\uD558\uACE0
      \uB048\uC9C8\uAE34 \uC0AC\uB0E5\uAFBC. \uD65C\uC5D0 \uB300\uC9C0\uC758 \uD798\uC744
      \uBD88\uC5B4\uB123\uC5B4 \uC801\uC5D0\uAC8C \uCE58\uBA85\uC801\uC778 \uC6D0\uAC70\uB9AC
      \uACF5\uACA9\uC744 \uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6377451259714
    m_Localized: "\uD14C\uB77C \uC2E0\uBCD1 \uAC80\uD22C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 6260046006501
    m_Localized: "\uD14C\uB77C \uAC00\uBB38\uC5D0 \uC785\uBB38\uD55C \uCD08\uBCF4
      \uAC80\uD22C\uC0AC. \uB300\uC9C0\uC758 \uD798\uC744 \uAC80\uC5D0 \uC2E4\uC5B4
      \uC2F8\uC6B0\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4172045612058
    m_Localized: "\uD14C\uB77C \uC2E0\uBCD1 \uAD70\uB2E8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8020457402355
    m_Localized: "\uB300\uC9C0\uC758 \uBC29\uD328\uB97C \uB4E0 \uD6C8\uB828\uBCD1.
      \uBC14\uC704\uCC98\uB7FC \uAD73\uAC74\uD55C \uBC29\uC5B4\uB825\uC744 \uBC30\uC6B0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9413971427123
    m_Localized: "\uD14C\uB77C \uC2E0\uBCD1 \uC554\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 6445572718067
    m_Localized: "\uB545\uC758 \uADF8\uB9BC\uC790\uAC00 \uB418\uC5B4 \uC801\uC758
      \uBE48\uD2C8\uC744 \uB178\uB9AC\uB294 \uCD08\uBCF4 \uC554\uC0B4\uC790. \uD759\uACFC
      \uADF8\uB9BC\uC790\uB97C \uC0AC\uC6A9\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9704655800281
    m_Localized: "\uD14C\uB77C \uC2E0\uBCD1 \uCC99\uD6C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 8660867951871
    m_Localized: "\uB300\uC9C0\uC758 \uD65C\uB825\uC744 \uD65C\uC5D0 \uB2F4\uC544
      \uC2F8\uC6B0\uB294 \uCD08\uBCF4 \uCC99\uD6C4\uBCD1. \uC6D0\uAC70\uB9AC\uC5D0\uC11C
      \uC801\uC744 \uC81C\uC555\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2159569040261
    m_Localized: "\uD14C\uB77C \uC2E0\uBCD1 \uC0AC\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 7974166476836
    m_Localized: "\uB300\uC9C0\uC758 \uCE58\uC720\uB825\uC744 \uB2E4\uB8E8\uB294
      \uCD08\uBCF4 \uC0AC\uC81C. \uC790\uC5F0\uC758 \uD798\uC73C\uB85C \uC544\uAD70\uC744
      \uD68C\uBCF5\uD558\uB294 \uD6C8\uB828\uC744 \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6801833259967
    m_Localized: "\uD68C\uBCF5\uC758 \uC5F4\uB9E4"
    m_Metadata:
      m_Items: []
  - m_Id: 8475741910009
    m_Localized: "\uC804\uD22C \uC2DC\uC791 \uC2DC \uCD5C\uB300 \uCCB4\uB825\uC774
      50 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3954355543813
    m_Localized: "\uD798\uC758 \uC601\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 2484262527276
    m_Localized: "\uC804\uD22C \uC2DC\uC791 \uC2DC \uACF5\uACA9\uB825\uC774 20 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6039470760896
    m_Localized: "\uC218\uD638\uC758 \uBB3C\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 7005247478645
    m_Localized: "\uC804\uD22C \uC2DC\uC791 \uC2DC \uBC29\uC5B4\uB825\uC774 20 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1238352224337
    m_Localized: "\uC9C8\uC8FC\uC758 \uBB3C\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 3173237257175
    m_Localized: "\uC804\uD22C \uC2DC\uC791 \uC2DC \uBBFC\uCCA9\uC774 3 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2987436988290
    m_Localized: "\uAC15\uD654\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1897271079493
    m_Localized: "\uCE90\uB9AD\uD130\uB97C \uAC15\uD654\uD558\uB294\uB370 \uC0AC\uC6A9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4054293279340
    m_Localized: "\uAC15\uD654\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 4997008248914
    m_Localized: "\uCE90\uB9AD\uD130\uB97C \uAC15\uD654\uD558\uB294\uB370 \uC0AC\uC6A9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5296948572204
    m_Localized: "\uC0DD\uBA85\uC758 \uBD80\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 9931318642499
    m_Localized: "\uC804\uD22C \uC911 \uC0AC\uB9DD\uD558\uBA74 1\uD68C \uCD5C\uB300
      \uCCB4\uB825\uC73C\uB85C \uBD80\uD65C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9966543805428
    m_Localized: "\uC7AC\uD654 \uD32C\uB358\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 8093721202622
    m_Localized: "\uC2B9\uB9AC \uC2DC \uC2B9\uB9AC \uC218\uB2F9\uC758 20%\uB97C \uCD94\uAC00\uB85C
      \uC5BB\uACE0, \uD328\uBC30 \uC2DC \uC2B9\uB9AC \uC218\uB2F9\uB9CC\uD07C \uC783\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2362295475906
    m_Localized: "\uBD84\uB178\uC758 \uD32C\uB358\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 6673833072859
    m_Localized: "\uCCB4\uB825\uC774 30% \uC774\uD558\uC77C \uB54C \uACF5\uACA9\uB825\uC774
      25% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7177141631260
    m_Localized: "\uBCF5\uC218\uC758 \uBC18\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 5359276111875
    m_Localized: "\uC544\uAD70 \uC120\uC218\uAC00 \uC0AC\uB9DD\uD560 \uB54C\uB9C8\uB2E4
      \uACF5\uACA9\uB825\uACFC \uBC29\uC5B4\uB825\uC774 10% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4102885684419
    m_Localized: "\uC7AC\uC0DD\uC758 \uBD95\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 5715552490494
    m_Localized: "5\uCD08\uB9C8\uB2E4 \uCD5C\uB300 \uCCB4\uB825\uC758 1~2%\uB97C
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2659013588666
    m_Localized: "\uD53C\uC758 \uAC80\uC9D1"
    m_Metadata:
      m_Items: []
  - m_Id: 8321263621391
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uACF5\uACA9\uB825\uC774 5% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9580198497994
    m_Localized: "\uD3ED\uBC1C \uBBF8\uB07C"
    m_Metadata:
      m_Items: []
  - m_Id: 1064728613865
    m_Localized: "\uC0AC\uB9DD \uC2DC \uC790\uC2E0\uC758 \uCD5C\uB300 \uCCB4\uB825
      10%\uB9CC\uD07C \uD3ED\uBC1C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
