  - m_Id: 3474838345265
    m_Localized: "\uC608\uCE21\uD560 \uD300\uC744 \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1390940980715
    m_Localized: "\uC608\uCE21: {0} \uC2B9 (\uC801\uC911 \uC2DC +{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 9265544237754
    m_Localized: "\uC608\uCE21 \uC801\uC911! +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9120117598857
    m_Localized: "\uC608\uCE21 \uC2E4\uD328..."
    m_Metadata:
      m_Items: []
  - m_Id: 9285026264954
    m_Localized: "\uC0C1\uD0DC : {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9091697313708
    m_Localized: "\uB3C8\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 6256144324485
    m_Localized: "\uAD6C\uB9E4 \uC644\uB8CC!"
    m_Metadata:
      m_Items: []
  - m_Id: 4892377048809
    m_Localized: "\uD68D\uB4DD: {0} x{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 6054331919480
    m_Localized: "\uD68D\uB4DD: \uACE8\uB4DC +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7986991237100
    m_Localized: "\uB79C\uB364\uBF51\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7573413748387
    m_Localized: "\uBB34\uC791\uC704 \uC544\uC774\uD15C \uB610\uB294 \uACE8\uB4DC\uB97C
      \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3639639139649
    m_Localized: "\uD68D\uB4DD\uD55C \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8486077914346
