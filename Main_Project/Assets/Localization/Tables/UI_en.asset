    m_Metadata:
      m_Items: []
  - m_Id: 9215438641899
    m_Localized: "Head of House Terra and lord of the earth. Huge as a mountain with steadfast defense, a wise leader who listens to the voice of the earth."
    m_Metadata:
      m_Items: []
  - m_Id: 6534902259010
    m_Localized: "Rox Terra"
    m_Metadata:
      m_Items: []
  - m_Id: 2106110797929
    m_Localized: "A warrior who wields the power of rock, the source of the earth. His body is as hard as stone, and his hammer shakes the ground with every swing."
    m_Metadata:
      m_Items: []
