    m_Localized: "Ceraunos Fulger"
    m_Metadata:
      m_Items: []
  - m_Id: 6719550833927
    m_Localized: "Head of House Fulger and king of thunder. A warlike leader who rules the battlefield with lightning-fast judgment and overwhelming power."
    m_Metadata:
      m_Items: []
  - m_Id: 1945405439455
    m_Localized: "Iris Fulger"
    m_Metadata:
      m_Items: []
  - m_Id: 1586390333093
    m_Localized: "A shrine maiden of the thunder god and the house's spiritual pillar. Her whirlwind dance grants allies speed and agility."
    m_Metadata:
      m_Items: []
  - m_Id: 2175201862246
    m_Localized: "Pallus Fulger"
    m_Metadata:
      m_Items: []
  - m_Id: 5514253492597
