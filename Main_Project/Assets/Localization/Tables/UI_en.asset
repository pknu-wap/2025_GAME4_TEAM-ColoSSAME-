  - m_Id: 4382794359615
    m_Localized: "A novice priest who heals allies with holy light, training to mend wounds with the power of light."
    m_Metadata:
      m_Items: []
  - m_Id: 9310256951337
    m_Localized: "Atlas Mare"
    m_Metadata:
      m_Items: []
  - m_Id: 5280153130052
    m_Localized: "Head of House Mare and lord of the sea god. Commands the vast power of the ocean, a cool leader who hides his feelings like the deep sea."
    m_Metadata:
      m_Items: []
  - m_Id: 2266895764927
    m_Localized: "Eir Mare"
    m_Metadata:
      m_Items: []
  - m_Id: 1729444456230
    m_Localized: "A witch who wields the dark power hidden in the ocean depths, neutralizing enemies with poison and curses."
    m_Metadata:
      m_Items: []
  - m_Id: 4280058987889
    m_Localized: "Seren Mare"
    m_Metadata:
      m_Items: []
  - m_Id: 9714905162467
    m_Localized: "A warrior gentle as a wave but as steadfast as a rock, protecting allies with a shield made of water."
    m_Metadata:
      m_Items: []
  - m_Id: 1283640425550
    m_Localized: "Nereid Mare"
    m_Metadata:
      m_Items: []
  - m_Id: 3438261224752
    m_Localized: "An assassin who moves as fast as a current, reading the flow of water to predict enemy moves and striking weak points with twin blades."
    m_Metadata:
      m_Items: []
  - m_Id: 9808411672876
    m_Localized: "Atel Mare"
    m_Metadata:
      m_Items: []
  - m_Id: 9347771227756
    m_Localized: "A prophet who foretells the future through the tides. Her prophecies grant allies a chance at victory, and her songs the power to heal."
    m_Metadata:
      m_Items: []
  - m_Id: 8783523210064
    m_Localized: "Mare Recruit Gladiator"
    m_Metadata:
      m_Items: []
  - m_Id: 4077405574250
    m_Localized: "A novice gladiator of House Mare, honing swordsmanship as flexible and powerful as the waves."
    m_Metadata:
      m_Items: []
  - m_Id: 7489452493237
    m_Localized: "Mare Recruit Legionary"
    m_Metadata:
      m_Items: []
  - m_Id: 9285662009769
    m_Localized: "A trainee bearing a shield of the sea, learning a defense as solid as ice."
    m_Metadata:
      m_Items: []
  - m_Id: 6094701277599
    m_Localized: "Mare Recruit Assassin"
    m_Metadata:
      m_Items: []
  - m_Id: 3673297466425
    m_Localized: "A novice assassin who becomes a shadow of the sea, learning to move as fluidly as flowing water."
    m_Metadata:
      m_Items: []
  - m_Id: 1637972374937
    m_Localized: "Mare Recruit Skirmisher"
    m_Metadata:
      m_Items: []
  - m_Id: 6217290160874
    m_Localized: "A novice skirmisher who shoots ice arrows, training to pin down foes from afar."
