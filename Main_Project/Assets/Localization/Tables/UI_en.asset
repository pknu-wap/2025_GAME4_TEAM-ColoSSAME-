    m_Localized: "Silverine Nox"
    m_Metadata:
      m_Items: []
  - m_Id: 5490579795904
    m_Localized: "The house's mage who turns moonlight into magic, specializing in confusing enemy minds and sapping their strength."
    m_Metadata:
      m_Items: []
