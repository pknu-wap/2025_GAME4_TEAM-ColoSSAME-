    m_Metadata:
      m_Items: []
  - m_Id: 5286593980124
    m_Localized: "A witch of thorn flowers who hides deadly poison behind her beauty. A cruel mage who wields poison herbs and venom."
    m_Metadata:
      m_Items: []
  - m_Id: 6896184782186
    m_Localized: "Semia Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 5343485757902
    m_Localized: "A pure-souled spirit caller who communes with forest spirits and wields the power of seeds, the origin of all life."
    m_Metadata:
      m_Items: []
  - m_Id: 2348211201775
    m_Localized: "Viva Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 3495990950450
    m_Localized: "A cheerful warrior who fights with the forest's vitality in her blade, empowering allies and dealing lethal blows to enemies."
    m_Metadata:
      m_Items: []
