    m_Metadata:
      m_Items: []
  - m_Id: 8108881944716
    m_Localized: "A legendary blacksmith who protects allies with the iron shields and armor he forges, and Castien's steadfast advisor."
    m_Metadata:
      m_Items: []
  - m_Id: 2631637613013
    m_Localized: "Seraphina Lumen"
    m_Metadata:
      m_Items: []
  - m_Id: 7695211516968
