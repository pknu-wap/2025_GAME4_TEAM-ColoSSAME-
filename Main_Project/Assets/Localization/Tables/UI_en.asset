    m_Localized: "Zephyros Caelus"
    m_Metadata:
      m_Items: []
  - m_Id: 7777599622557
    m_Localized: "Head of House Caelus and king of storms. Leads the team like the wind with noble, cool-headed leadership."
    m_Metadata:
      m_Items: []
