    m_Localized: "Lupina Nox"
    m_Metadata:
      m_Items: []
  - m_Id: 1307079291580
    m_Localized: "Head of House Nox and lord of the night. A noble by day and an assassin by night, a cold strategist who acts for the house's gain."
    m_Metadata:
      m_Items: []
