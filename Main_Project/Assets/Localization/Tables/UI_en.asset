    m_Localized: "Rounds"
    m_Metadata:
      m_Items: []
  - m_Id: 7910581597746
    m_Localized: "Aetherius Astra"
    m_Metadata:
      m_Items: []
  - m_Id: 5096671372289
    m_Localized: "Head of House Astra and prophet of fate. Reads the future in the movement of the stars and wields the power to steer destiny."
    m_Metadata:
      m_Items: []
  - m_Id: 2078809755764
    m_Localized: "Selene Astra"
    m_Metadata:
      m_Items: []
  - m_Id: 2173690777788
    m_Localized: "A witch who commands the power of the moon. Her magic shifts with the lunar phases, confusing enemy minds and hindering their actions."
    m_Metadata:
      m_Items: []
  - m_Id: 5187293058353
    m_Localized: "Comet Astra"
    m_Metadata:
      m_Items: []
  - m_Id: 4098350090236
    m_Localized: "A warrior who strikes as fast and hard as a comet. His sword holds starlight that bursts with every lethal blow."
    m_Metadata:
      m_Items: []
  - m_Id: 1415957684961
    m_Localized: "Orion Astra"
    m_Metadata:
      m_Items: []
  - m_Id: 1029212047063
    m_Localized: "An archer who channels the power of the constellations into her bow, loosing deadly arrows with the strength of Orion."
    m_Metadata:
      m_Items: []
  - m_Id: 8733250306778
    m_Localized: "Tyra Astra"
    m_Metadata:
      m_Items: []
  - m_Id: 3930993938188
    m_Localized: "An unpredictable supporter who rolls the dice of fate, bringing luck to allies and misfortune to enemies."
    m_Metadata:
      m_Items: []
