    m_Localized: "Sylva Caelus"
    m_Metadata:
      m_Items: []
  - m_Id: 9196750137364
    m_Localized: "A dancer who confounds enemies with free, unpredictable movements like the wind, quietly striking at weak points."
    m_Metadata:
      m_Items: []
