    m_Localized: "Mare Recruit Sorcerer"
    m_Metadata:
      m_Items: []
  - m_Id: 6552176799614
    m_Localized: "A novice sorcerer of water magic, training to overwhelm enemies with powerful torrents."
    m_Metadata:
      m_Items: []
  - m_Id: 8934424977176
    m_Localized: "Morpheus Mors"
    m_Metadata:
      m_Items: []
  - m_Id: 9126132177118
    m_Localized: "Head of House Mors and high priest of death. A powerful mage in a skull mask who blurs the line between life and death."
    m_Metadata:
      m_Items: []
  - m_Id: 1404448406395
    m_Localized: "Lise Mors"
    m_Metadata:
      m_Items: []
  - m_Id: 8425406312668
    m_Localized: "A puppeteer who crafts cursed dolls to weaken and control enemies. Despite her innocent looks, she wields deadly curses."
    m_Metadata:
      m_Items: []
  - m_Id: 8905241515728
    m_Localized: "Sena Mors"
    m_Metadata:
      m_Items: []
  - m_Id: 5421171578767
    m_Localized: "A knight clad in armor made from the bones of the dead. A steadfast defender who overcame past loss and does not fear death."
    m_Metadata:
      m_Items: []
  - m_Id: 2535593564491
    m_Localized: "Spectra Mors"
    m_Metadata:
      m_Items: []
  - m_Id: 3186634837593
    m_Localized: "An archer whose arrows carry the souls of the dead, bearing a deadly curse that eats away at the enemy's life."
    m_Metadata:
      m_Items: []
  - m_Id: 4518092446779
    m_Localized: "Blood Mors"
    m_Metadata:
      m_Items: []
  - m_Id: 1345413806296
    m_Localized: "A powerful warrior who fights with the power of death in his own blood, offering it to empower allies and crush enemies."
    m_Metadata:
      m_Items: []
