    m_Localized: "Prunus Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 6685760878553
    m_Localized: "A forest guardian with convictions as firm as an oak, binding enemies with mighty vines and protecting allies."
    m_Metadata:
      m_Items: []
