      m_Items: []
  - m_Id: 4163161399344
    m_Localized: "A novice sorcerer of fire magic, training to overwhelm enemies with mighty flames."
    m_Metadata:
      m_Items: []
  - m_Id: 3432261860449
    m_Localized: "Castien Lumen"
    m_Metadata:
      m_Items: []
  - m_Id: 6507664787111
    m_Localized: "Head of House Lumen and commander of the paladins of light. Pursues absolute justice and protects allies with a shield of light."
    m_Metadata:
      m_Items: []
  - m_Id: 1782459058675
