    m_Metadata:
      m_Items: []
  - m_Id: 2669651748540
    m_Localized: "Caelus"
    m_Metadata:
      m_Items: []
  - m_Id: 3915245820485
    m_Localized: "“A noble house that rules the sky and wind.\nKnown for swift, elegant tactics.”"
    m_Metadata:
      m_Items: []
  - m_Id: 8097670945883
    m_Localized: "Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 3147663190562
    m_Localized: "“A house that inherits the breath of forest and life.\nWields the power of healing and renewal.”"
    m_Metadata:
      m_Items: []
  - m_Id: 7444225751061
    m_Localized: "Ignis"
    m_Metadata:
      m_Items: []
  - m_Id: 2473946305703
    m_Localized: "“A house of flame with dragon blood in its veins.\nBurns its foes with fierce attacks and an unyielding spirit.”"
    m_Metadata:
      m_Items: []
  - m_Id: 2719716998241
    m_Localized: "Lumen"
    m_Metadata:
      m_Items: []
  - m_Id: 5409284014177
    m_Localized: "“A house of paladins guarding the order of light and steel.\nBelieves in steadfast defense and the power of justice.”"
    m_Metadata:
      m_Items: []
  - m_Id: 5112203982308
    m_Localized: "Nox"
    m_Metadata:
      m_Items: []
  - m_Id: 4033415795740
    m_Localized: "“A house of shadows that follows the mysteries of night and moon.\nStrikes with stealthy, lethal blows.”"
    m_Metadata:
      m_Items: []
  - m_Id: 5038007080673
    m_Localized: "Mors"
    m_Metadata:
      m_Items: []
  - m_Id: 1938549320094
    m_Localized: "“A house that serves the priests of death and curses.\nCurses its foes with the power of wraiths.”"
    m_Metadata:
      m_Items: []
  - m_Id: 2112303006551
    m_Localized: "Fulger"
    m_Metadata:
      m_Items: []
  - m_Id: 5044088708701
    m_Localized: "“A house of speed chosen by the god of thunder.\nUnleashes attacks as fast and fierce as lightning.”"
    m_Metadata:
      m_Items: []
  - m_Id: 7143287349910
    m_Localized: "Mare"
    m_Metadata:
      m_Items: []
  - m_Id: 9327606126929
    m_Localized: "“A house that holds the depths of the sea.\nFlexible as flowing water, and cool-headed.”"
    m_Metadata:
      m_Items: []
  - m_Id: 9776041943449
    m_Localized: "Terra"
    m_Metadata:
      m_Items: []
  - m_Id: 2026216207008
    m_Localized: "“A house of guardians of earth and mountain.\nTough defenses and an unshakable will.”"
    m_Metadata:
      m_Items: []
  - m_Id: 1917726114099
    m_Localized: "Astra"
    m_Metadata:
      m_Items: []
  - m_Id: 9121744142524
    m_Localized: "“A house of prophets who read the stars and fate.\nSees through the flow of battle with mystic power.”"
    m_Metadata:
      m_Items: []
